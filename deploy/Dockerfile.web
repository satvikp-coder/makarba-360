# Public web tier. Build context: repository root. No secrets are used or needed at build time.
FROM node:22.11-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile && pnpm -r build
# The browser bundle must contain no server secret; the build fails here if it does.
RUN apk add --no-cache python3 && python3 scripts/scan_secrets.py --bundle apps/web/dist --value-env SESSION_SECRET DATABASE_URL

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
