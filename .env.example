# Synthetic development values only. Copy to .env (git-ignored). Never commit real secrets.
NODE_ENV=development
APP_ENV=local
API_PORT=4000
DATABASE_URL=postgres://makarba_dev:makarba_dev_password@localhost:5432/makarba_dev
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Optional: the read-only public API role (makarba_public_api). Different credentials from DATABASE_URL. Public API is not mounted without it.
# READONLY_DATABASE_URL=postgres://makarba_public_dev:makarba_dev_public@localhost:5432/makarba_dev
# Optional identity provider (all four or none; https outside local). The client secret lives only in the platform secret store.
# OIDC_ISSUER=https://idp.example.org
# OIDC_CLIENT_ID=makarba
# OIDC_CLIENT_SECRET=replace-with-the-provider-client-secret
# OIDC_REDIRECT_URI=http://localhost:4000/auth/callback
POSTGRES_USER=makarba_dev
POSTGRES_PASSWORD=makarba_dev_password
POSTGRES_DB=makarba_dev
